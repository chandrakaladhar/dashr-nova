{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dashr-nova values",
  "type": "object",
  "required": ["database", "temporal", "opa", "image"],
  "properties": {
    "database": {
      "type": "object",
      "description": "PostgreSQL connection. Provide existingSecret (recommended) or url.",
      "properties": {
        "existingSecret": { "type": "string", "description": "Secret holding the connection string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "description": "Connection string given directly (dev/trials)" },
        "poolMax": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "properties": { "existingSecret": { "type": "string", "minLength": 1 } }, "required": ["existingSecret"] },
        { "properties": { "url": { "type": "string", "pattern": "^postgres(ql)?://" } }, "required": ["url"] }
      ]
    },
    "temporal": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "address": { "type": "string", "description": "host:port of the Temporal frontend" },
        "namespace": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": ["address"],
        "properties": { "address": { "type": "string", "pattern": "^[^:]+:[0-9]+$" } }
      }
    },
    "opa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string", "description": "Base URL of the OPA REST API" },
        "policyPath": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": ["url"],
        "properties": { "url": { "type": "string", "pattern": "^https?://" } }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
  }
}
